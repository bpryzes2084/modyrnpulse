{
  // Cloudflare Workers config for modyrnpulse.com.
  // Dashboard build settings: build command `node build.mjs`, deploy command `npx wrangler deploy`.
  "name": "modyrnpulse",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Membership pages and /api/* run the Worker code; every other page is served straight from dist/.
    "run_worker_first": ["/api/*", "/members", "/members/*", "/join", "/join/*", "/welcome", "/welcome/*", "/login", "/login/*", "/logout", "/logout/*", "/account", "/account/*", "/reset", "/reset/*"]
  },
  "d1_databases": [
    {
      // Members, sessions and (switched-off) email sign-ups. Schema: migrations/0002_members.sql
      "binding": "DB",
      "database_name": "modyrnpulse-members",
      "database_id": "ef2fa36b-5f40-4582-96d0-25f36111384c"
    }
  ]
}
